rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Checks whether the signed-in user has admin permissions
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Allows customers to view menus while restricting changes to admin
    match /menus/{menuId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Allows customers to view menu photos while restricting changes to admin
    match /menuItemImages/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Allows customers to view catering availability while only admin can change it
    match /availability/{dateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Allows customers to submit new orders while admin manage existing orders
    match /orders/{orderId} {
      // Only admin can view existing orders
      allow read: if isAdmin();

      // Allows customers to submit orders with the required inital statuses
      allow create: if (
        (request.resource.data.paymentMethod == "Cash"
          && request.resource.data.status == "Open")
        ||
        (request.resource.data.paymentMethod in ["Venmo", "PayPal", "Zelle"]
          && request.resource.data.status == "Pending Payment")
      )
        && request.resource.data.paymentStatus == "Not Paid"
        && request.resource.data.keys().hasOnly([
          "customerName",
          "phone",
          "email",
          "menuType",
          "location",
          "eventName",
          "items",
          "total",
          "paymentMethod",
          "paymentStatus",
          "status",
          "createdAt",
        ]);
        
      // Only admin can update or delete orders
      allow update, delete: if isAdmin();
    }

    // Allows customers to submit catering requests while admin manage them
    match /cateringRequests/{requestId} {
      // Only admin can view existing catering requests
      allow read: if isAdmin();

      // Allows new requests with the required initial status
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "customerName",
          "contactInformation",
          "date",
          "time",
          "guestCount",
          "menuPreferences",
          "venueName", 
          "venueAddress",
          "specialNotes",
          "status",
          "createdAt"
        ]);

      // Only admin can update or delete catering requests
      allow update, delete: if isAdmin();
    }

    // Protects customer profiles and prevents unauthorized admin access
    match /users/{userId} {
      // Users can read their own profile, admin can read all profiles
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // New accounts can only create their own profiles with the customer role
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.role == "customer"
      && request.resource.data.keys().hasOnly([
        "name",
        "phone",
        "email",
        "role"
      ]);

      // Only admin can modify or delete existing user profiles
      allow update, delete: if isAdmin();
    }
  }
}